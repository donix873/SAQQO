# Copy this file to .env on the server. Never commit the real values.
SAQGO_ENV=development
SAQGO_ALLOWED_ORIGINS=https://donix873.github.io,http://localhost:3000,http://localhost:8080

# Server-only keys. Do NOT place these in Flutter, web/, or GitHub Pages.
YANDEX_GEOCODER_API_KEY=
YANDEX_ROUTE_DETAILS_API_KEY=
YANDEX_DISTANCE_MATRIX_API_KEY=
YANDEX_ISOCHRONE_API_KEY=

# Optional: override only after confirming the current Yandex contract.
YANDEX_ROUTE_DETAILS_URL=https://api.routing.yandex.net/v2/route
YANDEX_DISTANCE_MATRIX_URL=https://api.routing.yandex.net/v2/distancematrix

